{
  "name": "dsh-marktext",
  "version": "0.1.12",
  "description": "MarkText (muya) WYSIWYG Markdown editor in the DeepSeek Harness right sidebar: open .md files, edit them as rendered documents, save back with a version guard.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "renderer",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "editor",
    "marktext",
    "muya",
    "wysiwyg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build:renderer": "node scripts/prepare-renderer.mjs && vite build --config src/renderer/vite.config.js",
    "test": "node --test test/*.test.mjs",
    "prepare:renderer": "node scripts/prepare-renderer.mjs"
  },
  "devDependencies": {
    "@muyajs/core": "0.2.0",
    "vite": "^7.3.7",
    "mermaid": "11.15.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roland0511/dsh-marktext.git"
  },
  "homepage": "https://github.com/Roland0511/dsh-marktext",
  "bugs": {
    "url": "https://github.com/Roland0511/dsh-marktext/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
